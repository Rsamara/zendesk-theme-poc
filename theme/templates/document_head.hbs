<meta content="width=device-width, initial-scale=1.0" name="viewport" />



  <script type="text/javascript">
  {{! User object }}
  window.User = {
    id: {{json user.id}},
    role: {{json user.role}},
    agent: {{json user.agent}},
    signedIn: {{signed_in}},
  };

  {{#if user}}
  fetch('/api/v2/users/me.json')
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.user && data.user.user_fields) {
        window.User.britePay = data.user.user_fields.brite_pay_support === true;
        window.User.payPilot = data.user.user_fields.brite_pay_pilot === true;
      }
    });
  {{/if}}


  
  {{! Theme object }}
  window.Theme = Object.assign(window.Theme || {}, {
    version: '3.0.0',

    {{! Localization }}
    locale: {{json help_center.locale}},
    baseLocale: {{json help_center.base_locale}},

    l18n: {
      categories: {{json (t 'categories')}},
      articles: {{json (t 'articles')}},
      topics: {{json (t 'topics')}},
      posts: {{json (t 'posts')}},
      showAllArticles: {{json (t 'show_all_articles' count='{count}')}},
      showAllSections: {{json (t 'see_all_sections')}},
      more: {{json (t 'see_more')}},
      empty: {{json (t 'empty')}},
      close: {{json (t 'close')}},
      search: {{json (t 'search')}},
      clearSearch: {{json (t 'search_clear')}},
      toggleNavigation: {{json (t 'toggle_navigation')}},
    },

    urls: {
      homePage: {{json (page_path 'help_center')}},
      newRequestPage: {{json (page_path 'new_request')}}
    },
    images: {
      placeholder: {{json (asset 'placeholder.png')}},
    },

    {{! Settings (used by Garden components) }}
    settings: {
      brand_color: {{json settings.color_primary}},
      brand_text_color: {{json settings.color_primary_inverse}},
      text_color: {{json settings.color_text}},
      link_color: {{json settings.color_link}},
      hover_link_color: {{json settings.color_link}},
      visited_link_color: {{json settings.color_link}},
      background_color: {{json settings.bg_color}},
      border_color: {{json settings.color_border}}
    },

    {{! CSS import map }}
    css: {
      'fancybox': 'https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0.36/dist/fancybox/fancybox.min.css',
      'plyr': 'https://cdn.jsdelivr.net/npm/plyr@3.7.8/dist/plyr.css',
      'swiper': 'https://cdn.jsdelivr.net/npm/swiper@11.2.6/swiper-bundle.min.css'
    },

    {{! Elements }}
    elements: {
      notification: { {{~#if settings.notification_content}}
        content: {{json (dc settings.notification_content)}},
        icon: 'fa-regular fa-circle-question',
        dismissible: true
      {{/if~}} },
      header: {
        fixed: {{json settings.fixed_header}},
        sticky: {{json settings.sticky_header}},
        style: {{json settings.nav_style}},
        layout: {{json settings.header_layout}},
        breakpoint: {{json settings.nav_breakpoint}}
      }
    },

    {{! Animation and transition effects }}
    animations: {
      '.hero-content': 'fade-in-up',
      {{~#isnt settings.animations 'none'}}
        {{~#contains settings.custom_block_style 'cards'}}'#custom-blocks .card': '{{settings.animations}}',{{/contains}}
        {{~#contains settings.content_block_style 'cards'}}'#category-list .card': '{{settings.animations}}',{{/contains}}
        {{~#contains settings.contact_block_style 'cards'}}'#contact-blocks .card': '{{settings.animations}}',{{/contains}}
        '#promoted-videos .card': '{{settings.animations}}',
      {{/isnt~}}
    },
    transitions: {}
  });

  // Load ES module polyfill for browsers that don't support ES modules
  if (!(HTMLScriptElement.supports && HTMLScriptElement.supports('importmap'))) {
    document.write('<script async src="{{asset 'es-modules.min.js'}}"><\/script>');
  }

  // Maybe enable dark mode
  if (window.sessionStorage.getItem('dark-mode') === 'true') {
    document.documentElement.classList.add('dark-mode')
  }
</script>  


