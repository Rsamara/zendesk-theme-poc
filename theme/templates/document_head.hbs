{{! Built-in element styles }}
<style id="element-styles">
  .hero-content { visibility: hidden; }
  {{~#isnt settings.animations 'none'~}}
    {{~#contains settings.custom_block_style 'cards'}}#custom-blocks .card { visibility: hidden; }{{/contains}}
    {{~#contains settings.content_block_style 'cards'}}#category-list .card { visibility: hidden; }{{/contains}}
    {{~#contains settings.contact_block_style 'cards'}}#contact-blocks .card { visibility: hidden; }{{/contains}}
    #promoted-videos .card { visibility: hidden; }
  {{~/isnt~}}
</style>

{{! Custom page builder styles }}
<style id="page-builder-styles"></style>

{{! Custom page builder templates }}
<div id="page-builder-templates">

  {{! Breadcrumbs }}
  <script type="text/template" id="tmpl-breadcrumbs">
    <% if (links.length) { %>
      <nav class="element-group mb-0" aria-label="<%= get('label', '') %>">
        <ol class="flex flex-wrap align-items-center pl-0 mb-0">
          <% links.forEach((link, index) => { %>
            <li class="inline-flex align-items-center">
              <% if (index > 0) { %>
                <svg class="svg-icon bottom-0 px-1 text-inherit rotate-270" aria-hidden="true">
                  <use xlink:href="#icon-chevron-down" />
                </svg>
              <% } %>
              <a class="element-link" href="<%= link.html_url %>" aria-current="<%= link.current ? 'true' : 'false' %>">
                <%= link.title %>
              </a>
            </li>
          <% }) %>
        </ol>
      </nav>
    <% } %>
  </script>

  {{! Pagination }}
  <script type="text/template" id="tmpl-pagination">
    <% if (links.length) { %>
      <nav>
        <ul class="flex justify-content-center list-unstyled">
          <% links.forEach((link, index) => { %>
            <li class="<%= link.class_name %>">
              <a class="element-button button button-outline-brand button-sm inline-flex mx-1" href="<%= link.html_url %>" rel="nofollow">
                <% if ((link.class_name.includes('prev') || link.class_name.includes('first')) && link.icon) { %>
                  <span class="mr-1"><%= link.icon %></span>
                <% } %>
                <span><%= link.title %></span>
                <% if ((link.class_name.includes('next') || link.class_name.includes('last')) && link.icon) { %>
                  <span class="ml-1"><%= link.icon %></span>
                <% } %>
              </a>
            </li>
          <% }) %>
        </ul>
      </nav>
    <% } %>
      </script>

</div>
                  



                  
