{{! Page container }}
<div class="page-container flex" id="page-container">

  {{! Group }}
  <div class="element-group relative flex flex-column color-scheme-secondary bg-subtle" data-editable>

    {{! Container }}
    <div class="element-container container" data-editable>

      {{! Search }}
      {{~#is settings.header_search_style 'none'}}
        <div class="element-search search search-left search-lg my-5" data-editable>
          <h2 class="sr-only">{{t 'search' }}</h2>
          {{~#if settings.search_placeholder}}
            {{#if settings.use_translations}}
              {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_search submit=false placeholder=(dc settings.search_placeholder)}}
            {{else}}
              {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_search submit=false placeholder=settings.search_placeholder}}
            {{/if}}
          {{else}}
            {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_search submit=false}}
          {{/if~}}
          <svg class="search-icon transition" aria-hidden="true">
            <use xlink:href="#icon-search" />
          </svg>
        </div>
      {{/is~}} {{! / .element-search }}

    </div> {{! / .element-container }}

  </div> {{! / .element-group }}

  {{! Container }}
  <div class="element-container container flex-1" data-editable>

    {{! Row }}
    <div class="element-row row col-gap-x-lg h-full" data-editable>

      {{! Column (content) }}
      <div class="element-column page-content lg:col" data-editable>

        {{! Group }}
        <div class="element-group mt-6 mb-5" data-editable>

          {{! Heading }}
          <h1 class="element-heading my-0" data-editable>
            {{section.name}}
          </h1> {{! /.element-heading }}

          {{! Paragraph }}
          {{#if section.description}}
            <p class="element-paragraph mb-0 mt-3 font-size-lg text-subtle" data-editable>
              {{section.description}}
            </p>
          {{/if}} {{! /.element-paragraph }}

          {{! Subscribe }}
          {{#if settings.show_subscribe}}
            <div class="element-subscribe subscribe-section my-5 js-subscribe" data-class="button button-sm button-outline-brand" data-editable>
              {{subscribe}}
            </div>
          {{/if}} {{! / .element-subscribe }}

        </div> {{! /.element-group }}

        {{! Subsection list }}
        <div class="element-subsection-list my-6 empty:hidden" x-data id="subsection-list">
          {{#if section.sections}}
            <ul class="element-list list-unstyled list-bordered border-top border-bottom mb-0">
              {{#each section.sections}}
                <li class="relative">
                  <a class="element-link link-stretched flex justify-content-between align-items-center py-3 px-1 font-medium text-inherit hover:no-underline" href="{{url}}">
                    {{name}}
                    <svg class="svg-icon bottom-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9 18L15 12L9 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </li>
              {{/each}}
            </ul>
          {{/if}}

          {{! Pagination }}
          {{#if (pagination 'section.sections')}}
            <div class="element-pagination pagination my-6 js-pagination">
              {{pagination 'section.sections'}}
            </div>
          {{/if}}

        </div> {{! / .element-section-list }}

        {{! Article list }}
        <div class="element-article-list mb-7" x-data id="article-list">

          {{! Articles }}
          {{#if section.articles}}

            {{#if section.sections}}
              <h2 class="element-heading h3 mt-6 mb-2">
                {{t 'articles'}}
              </h2>
            {{/if}}

            <ul class="element-row row mb-0
              {{~#is settings.article_list_style 'bullet'}} col-gap-x-lg list-disc{{/is~}}
              {{~#is settings.article_list_style 'unstyled'}} list-unstyled{{/is~}}
              {{~#is settings.article_list_style 'bordered'}} list-unstyled list-bordered{{/is~}}">

              {{#each section.articles}}
                <li class="element-column col-12
                  {{~#if (compare ../settings.article_list_columns ">" "1")}}
                    {{~#is ../settings.article_list_style 'bordered'}}{{~#if @last}} border-bottom{{/if~}}{{/is~}}
                  {{/if~}}
                  {{~#if (compare ../settings.article_list_columns ">=" "2")}} md:col-6{{/if~}}
                  {{~#if (compare ../settings.article_list_columns ">=" "3")}} lg:col-4{{/if~}}">

                  <div class="relative media align-items-baseline py-2 h-full">

                    {{~#isnt ../settings.article_list_style 'bullet'}}
                      <template x-if="$theme.hasSymbol('icon-article')">
                        <svg class="svg-icon align-self-baseline mr-2">
                          <use :href="$theme.symbol('icon-article')" />
                        </svg>
                      </template>
                    {{/isnt}}

                    <div class="media-body">
                      <a class="element-link link-stretched text-inherit" href="{{url}}">{{title}}</a>
                      {{~#if promoted}}
                        <svg class="icon-promoted svg-icon ml-1 text-brand" aria-hidden="true">
                          <title>{{t 'promoted'}}</title>
                          <use xlink:href="#icon-promoted" />
                        </svg>
                      {{/if~}}
                      {{~#if internal~}}
                        <svg class="svg-icon ml-1 text-base" aria-hidden="true">
                          <title>{{t 'internal'}}</title>
                          <use xlink:href="#icon-internal" />
                        </svg>
                      {{~/if~}}
                      {{~#if ../settings.show_article_excerpt}}
                        <p class="element-paragraph my-2 font-size-md break-words">
                          {{snippet}}
                        </p>
                      {{/if~}}
                    </div>

                  </div>
                </li>
              {{/each}}
            </ul>
          {{else}}
            {{#unless section.sections}}
              <p class="element-paragraph">
                <a href="{{section.url}}">
                  {{t 'empty'}}
                </a>
              </p>
            {{/unless}}
          {{/if}}

          {{! Pagination }}
          {{#if (pagination 'section.articles')}}
            <div class="element-pagination pagination my-6 js-pagination">
              {{pagination 'section.articles'}}
            </div>
          {{/if}}

        </div> {{! / .element-article-list }}

      </div> {{! / .element-column }}

      {{! Sidebar left }}
      <aside class="element-sidebar sidebar flex-first color-scheme-secondary lg:sidebar-left lg:sidebar-sticky empty:hidden" x-data="sidebar" id="sidebar-left">

        {{! Navigation }}
        {{#isnt settings.section_sidebar 'none'}}
          <div
            class="element-navigation"
            id="navigation-section-sidebar"
            data-element="template"
            data-template="sidebar-{{settings.section_sidebar}}"
            data-template-data='{ "breakpoint": "lg", "activeSectionId": {{section.id}} }'>
          </div>
        {{/isnt}} {{! / .element-navigation }}

      </aside> {{! / .element-column }}

      {{! Sidebar right }}
      <aside class="element-sidebar sidebar lg:sidebar-right lg:sidebar-sticky empty:hidden" x-data="sidebar" id="sidebar-right">

        {{! Call-to-action }}
        {{~#is settings.cta_style 'sidebar'}}
          {{~#isnt settings.cta_location 'home'}}
            <div class="element-call-to-action color-scheme-{{settings.color_scheme_cta}} is-loading js-call-to-action" id="call-to-action-sidebar"></div>
          {{/isnt~}}
        {{/is~}} {{! / .element-call-to-action }}

      </aside> {{! / .element-column }}

    </div> {{! / .element-row }}

  </div> {{! / .element-container }}

  {{! Call to action }}
  {{~#isnt settings.cta_style 'none'}}
    {{~#isnt settings.cta_style 'sidebar'}}
      {{~#isnt settings.cta_location 'home'}}
        <div class="element-call-to-action color-scheme-{{settings.color_scheme_cta}} is-loading js-call-to-action" id="call-to-action"></div>
      {{/isnt~}}
    {{/isnt~}}
  {{/isnt~}} {{! / .element-call-to-action }}

</div> {{! / #page-container }}

<script type="text/javascript">
  {{! Section images }}
  {{~#each section.sections}}
    {{~#if (asset id prefix='section-' suffix='.svg')~}}Theme.images['section-{{id}}'] = "{{asset id prefix='section-' suffix='.svg'}}";{{~/if~}}
    {{~#if (asset id prefix='section-' suffix='.png')~}}Theme.images['section-{{id}}'] = "{{asset id prefix='section-' suffix='.png'}}";{{~/if~}}
    {{~#if (asset id prefix='section-' suffix='.jpg')~}}Theme.images['section-{{id}}'] = "{{asset id prefix='section-' suffix='.jpg'}}";{{~/if~}}
    {{~#if (asset id prefix='section-' suffix='.jpeg')~}}Theme.images['section-{{id}}'] = "{{asset id prefix='section-' suffix='.jpeg'}}";{{~/if~}}
  {{~/each~}}

  {{! Add class names the document element }}
  document.documentElement.classList.add('section-page', 'section-{{section.id}}');
  {{~#each (slice section.articles 0 1)}}
    {{~#each (slice path_steps 0 1)}}
      document.documentElement.classList.add(`category-${Util.getPageId('{{url}}')}`);
    {{/each~}}
  {{/each~}}
</script>