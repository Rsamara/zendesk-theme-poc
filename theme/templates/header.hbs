{{! Skip navigation link }}
<a class="sr-only sr-only-focusable" tabindex="1" href="#page-container">
  {{t 'skip_navigation'}}
</a>

<div class="layout{{#if settings.boxed_layout}} layout-boxed{{/if}}" id="page-layout">

  {{! Page header }}
  <header class="element-header header{{#if settings.fixed_header}} fixed-header{{/if}} color-scheme-tertiary" x-data="header" :class="{ 'is-stuck shadow': isStuck{{#is settings.bg_color_header settings.bg_color}}, 'border-bottom': !isFixed{{/is}} }" id="header">

    {{! Container }}
    <div class="container{{#if settings.full_width_header}}-fluid{{/if}} flex align-items-center justify-content-between h-full">

      {{! Logo }}      
      <a class="logo-link nav-link flex align-items-center px-0 mr-auto{{#is settings.nav_style 'standard'}} z-100{{/is}}" href="https://dev.hdbrite.com/" id="logo">        
       <img class="logo block img-fluid" src="{{settings.logo}}" alt="{{t 'home_page' name=help_center.name}}">

        {{! Tagline }}
        {{~#if settings.tagline}}
          <span class="element-paragraph tagline py-1 px-3 ml-2 border-left border-white font-medium white-space-no-wrap">
            {{~#if settings.use_translations}}
              {{dc settings.tagline}}
            {{else}}
              {{settings.tagline}}
            {{/if~}}
          </span>
        {{/if~}}
      </a>

      {{! Menu toggle }}
      <button class="menu-toggle nav-link ml-2 {{settings.nav_breakpoint}}:hidden" aria-label="{{t 'toggle_navigation'}}" x-bind="trigger">
        <span></span>
      </button>

      {{! Menu backdrop }}
      <template x-teleport=".header" @click="close">
        <div class="backdrop {{settings.nav_breakpoint}}:hidden" x-show="isMenuOpen" x-transition.opacity></div>
      </template>

      {{! Primary navigation menu }}
      <nav class="nav menu p-5{{#isnt settings.nav_style 'zoom-in'}} pt-8{{/isnt}} transition {{settings.nav_breakpoint}}:p-0{{#is settings.header_layout 'links-left'}} {{settings.nav_breakpoint}}:ml-6{{/is}}" x-cloak x-bind="menu">

        {{! Search }}
        {{#isnt settings.header_search_style 'none'}}

          {{! Inline }}
          <div class="element-search search-inline search search-left font-size-sm flex text-base mt-6 mb-4
            {{~#is settings.header_search_style 'inline'}} {{settings.nav_breakpoint}}:max-w-13 {{settings.nav_breakpoint}}:flex-1 {{settings.nav_breakpoint}}:mx-5 {{settings.nav_breakpoint}}:my-0{{/is~}}
            {{~#isnt settings.header_search_style 'inline'}} {{settings.nav_breakpoint}}:hidden{{/isnt~}}"
            x-data="headerSearch">
            {{#if settings.search_placeholder}}
              {{#if settings.use_translations}}
                {{search class='form-field flex-1 mb-0' instant=false submit=false placeholder=(dc settings.search_placeholder)}}
              {{else}}
                {{search class='form-field flex-1 mb-0' instant=false submit=false placeholder=settings.search_placeholder}}
              {{/if}}
            {{else}}
              {{search class='form-field flex-1 mb-0' instant=false submit=false}}
            {{/if}}
            <svg class="search-icon transition" viewBox="0 0 12 12" aria-hidden="true">
              <use xlink:href="#icon-search" />
            </svg>
          </div>

          {{! Button }}
          {{#is settings.header_search_style 'button'}}
            <div x-data="headerSearch">
              <button class="search-button not-a-button nav-link hidden {{settings.nav_breakpoint}}:block" @click="showSearch">
                <svg class="svg-icon" aria-hidden="true">
                  <use xlink:href="#icon-search" />
                </svg>
              </button>
              <template x-teleport=".header" @keydown.escape="hideSearch">
                <div class="backdrop z-100" x-show="isVisible" x-transition.opacity>
                  <div class="container" x-ref="overlay" style="padding-top: {{settings.header_height}}">
                    <div class="search search-left search-lg my-4 mx-auto max-w-md text-base" @click.away="hideSearch">
                      {{~#if settings.search_placeholder}}
                        {{#if settings.use_translations}}
                          {{search class='form-field mb-0' submit=false instant=settings.instant_search placeholder=(dc settings.search_placeholder)}}
                        {{else}}
                          {{search class='form-field mb-0' submit=false instant=settings.instant_search placeholder=settings.search_placeholder}}
                        {{/if}}
                      {{else}}
                        {{search class='form-field mb-0' submit=false instant=settings.instant_search}}
                      {{/if~}}
                      <svg class="search-icon transition" aria-hidden="true">
                        <use xlink:href="#icon-search" />
                      </svg>
                    </div>
                  </div>
                </div>
              </template>
            </div>
          {{/is}}

        {{/isnt}}

        {{! Header link 1 }}
        {{~#if settings.header_link_1_text}}
          <a class="element-nav-link header-link-1 nav-link" href="{{#if settings.use_translations}}{{dc settings.header_link_1_url}}{{else}}{{settings.header_link_1_url}}{{/if}}" x-data="link">
            {{#if settings.use_translations}}
              {{dc settings.header_link_1_text}}
            {{else}}
              {{settings.header_link_1_text}}
            {{/if}}
          </a>
        {{/if~}}

        {{! Header link 2 }}
        {{~#if settings.header_link_2_text}}
          <a class="element-nav-link header-link-2 nav-link" href="{{#if settings.use_translations}}{{dc settings.header_link_2_url}}{{else}}{{settings.header_link_2_url}}{{/if}}" x-data="link">
            {{#if settings.use_translations}}
              {{dc settings.header_link_2_text}}
            {{else}}
              {{settings.header_link_2_text}}
            {{/if}}
          </a>
        {{/if~}}

        {{! Header link 3 }}
        {{~#if settings.header_link_3_text}}
          <a class="element-nav-link header-link-3 nav-link" href="{{#if settings.use_translations}}{{dc settings.header_link_3_url}}{{else}}{{settings.header_link_3_url}}{{/if}}" x-data="link">
            {{#if settings.use_translations}}
              {{dc settings.header_link_3_text}}
            {{else}}
              {{settings.header_link_3_text}}
            {{/if}}
          </a>
        {{/if~}}
        <a class="element-nav-link header-link-4 nav-link" href="#">Pinnacle</a>
        <a class="element-nav-link header-link-5 nav-link" href="https://dev.hdbrite.com/report-center/reports">Reports</a>
        <a class="element-nav-link header-link-6 nav-link" href="https://hunterdouglas-dealer1775168019.zendesk.com/hc/en-us">Support</a>
        <!--<a id="brite-pay-nav-link" class="element-nav-link header-link-7 nav-link" href="https://hunterdouglas-dealer1775168019.zendesk.com/hc/en-us/p/brite_pay" style="display:none;">Brite Pay</a>-->
 

        {{! Category dropdown }}
        {{~#isnt settings.category_dropdown_style 'none'}}
          <div x-data="navigation({ categories: [] })">
            <div class="dropdown h-full" x-data="dropdown" x-bind="wrapper">
              <button
                class="element-nav-link nav-link not-a-button{{#isnt settings.nav_style 'slide-in'}} w-full{{/isnt}}"
                aria-haspopup="true"
                x-bind="trigger">
                {{t 'categories'}}
                <svg class="svg-icon" aria-hidden="true" :class="{ 'rotate-180': isExpanded }">
                  <use xlink:href="#icon-chevron-down" />
                </svg>
              </button>
              <div class="dropdown-menu w-full {{settings.nav_breakpoint}}:w-auto" role="menu" x-cloak x-bind="menu">
                <template x-for="category in categories">
                  <a
                    class="element-dropdown-item dropdown-item{{#is settings.nav_style 'standard'}} justify-content-center {{settings.nav_breakpoint}}:justify-content-start{{/is}}"
                    :href="category.html_url"
                    rel="nofollow"
                    x-text="category.name">
                  </a>
                </template>
              </div>
            </div>
          </div>
        {{/isnt~}}

        {{! Language selector }}
        {{#is settings.language_selector_location 'header'}}
          {{#if alternative_locales}}
            <div class="dropdown" x-data="dropdown" x-bind="wrapper">
              <button class="element-nav-link nav-link not-a-button{{#isnt settings.nav_style 'slide-in'}} w-full{{/isnt}}" aria-haspopup="true" x-bind="trigger">
                <svg class="svg-icon mr-1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 12H22M2 12C2 17.5228 6.47715 22 12 22M2 12C2 6.47715 6.47715 2 12 2M22 12C22 17.5228 17.5228 22 12 22M22 12C22 6.47715 17.5228 2 12 2M12 2C14.5013 4.73835 15.9228 8.29203 16 12C15.9228 15.708 14.5013 19.2616 12 22M12 2C9.49872 4.73835 8.07725 8.29203 8 12C8.07725 15.708 9.49872 19.2616 12 22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {{current_locale.name}}
                <svg class="svg-icon" aria-hidden="true" :class="{ 'rotate-180': isExpanded }">
                  <use xlink:href="#icon-chevron-down" />
                </svg>
              </button>
              <div class="dropdown-menu w-full {{settings.nav_breakpoint}}:w-auto" role="menu" x-cloak x-bind="menu">
                {{#each alternative_locales}}
                  <a
                    class="element-dropdown-item dropdown-item{{#is ../settings.nav_style 'standard'}} justify-content-center {{../settings.nav_breakpoint}}:justify-content-start{{/is}}"
                    href="{{url}}"
                    dir="{{direction}}"
                    rel="nofollow">
                    {{name}}
                  </a>
                {{/each}}
              </div>
            </div>
          {{/if}}
        {{/is}}

        {{! Separator }}
        {{#isnt settings.header_layout 'links-right'}}
          <div class="{{settings.nav_breakpoint}}:ml-auto"></div>
        {{/isnt}}

        {{! Dark mode toggle }}

        {{! Submit a Request link }}
        {{#isnt settings.submit_a_request_link_style 'none'}}
          {{#if (link 'new_request')}}
            {{#contains settings.submit_a_request_link_style 'button'}}
              <a
                class="element-button button {{settings.submit_a_request_link_style}} link-submit-a-request flex-last mt-3 {{settings.nav_breakpoint}}:order-inherit {{settings.nav_breakpoint}}:mt-0 {{settings.nav_breakpoint}}:mx-2"
                href="{{page_path 'new_request'}}">
                {{t 'submit_a_request'}}
              </a>
            {{else}}
              <a class="element-nav-link nav-link link-submit-a-request" href="{{page_path 'new_request'}}">
                {{t 'submit_a_request'}}
              </a>
            {{/contains}}
          {{/if}}
        {{/isnt}}

        {{! Sign in link }}
        {{#isnt settings.sign_in_link_style 'none'}}
          {{#unless signed_in}}
            {{#contains settings.sign_in_link_style 'button'}}
              <a
                class="element-button button {{settings.sign_in_link_style}} link-sign-in flex-last mt-3 {{settings.nav_breakpoint}}:order-inherit {{settings.nav_breakpoint}}:mt-0 {{settings.nav_breakpoint}}:ml-2"
                href="{{page_path 'sign_in'}}">
                {{t 'sign_in'}}
              </a>
            {{else}}
              <a class="element-nav-link nav-link link-sign-in" href="{{page_path 'sign_in'}}">
                {{t 'sign_in'}}
              </a>
            {{/contains}}
          {{/unless}}
        {{/isnt}}

        {{! User menu }}
        {{~#if signed_in}}
          {{! Desktop }}
          <div class="user-menu dropdown hidden {{settings.nav_breakpoint}}:flex" x-data="dropdown" x-bind="wrapper" id="user-menu">
            <button class="element-nav-link nav-link not-a-button text-center{{#isnt settings.nav_style 'slide-in'}} w-full{{/isnt}}" aria-haspopup="true" x-bind="trigger">
              <span class="user-avatar avatar avatar-sm -my-2">
                {{user_avatar class="avatar-img border-0"}}
                <span class="absolute top-0 right-0 -mt-1 w-4 h-4 font-size-xs font-medium text-white bg-warning circle" x-data="requests" x-text="count"></span>
              </span>
              <span class="user-name ml-1 sr-only">
                {{user_name}}
              </span>
              <svg class="svg-icon ml-1" aria-hidden="true" :class="{ 'rotate-180': isExpanded }">
                <use xlink:href="#icon-chevron-down" />
              </svg>
            </button>
            <div class="dropdown-menu" role="menu" x-cloak x-bind="menu">
              <!--{{#my_profile class='element-dropdown-item dropdown-item'}}
                {{t 'profile'}}
              {{/my_profile}}-->
              {{#link "requests" class='element-dropdown-item dropdown-item'}}
                {{t 'requests'}}
                <span class="request-count ml-1" x-data="requests" x-text="`(${count})`"></span>
              {{/link}}
              <!--{{#link "contributions" class='element-dropdown-item dropdown-item'}}
                {{t "activities"}}
              {{/link}}-->
              {{link 'service_catalog' class='element-dropdown-item dropdown-item'}}
              <!--{{link "approval_requests" class='element-dropdown-item dropdown-item'}}-->
              {{contact_details class='element-dropdown-item dropdown-item line-height-normal cursor-pointer'}}
              {{change_password class='element-dropdown-item dropdown-item line-height-normal cursor-pointer'}}
              {{link "sign_out" class='element-dropdown-item dropdown-item'}}
            </div>
          </div>

          {{! Mobile }}
          <div class="{{settings.nav_breakpoint}}:hidden">
            <div class="hr m-3"></div>
            <!--{{#my_profile class='element-nav-link link-profile nav-link'}}
              {{t 'profile'}}
            {{/my_profile}}-->
            {{#link "requests" class='element-nav-link link-requests nav-link'}}
              {{t 'requests'}}
              <span class="request-count ml-1" x-data="requests" x-text="`(${count})`"></span>
            {{/link}}
            <!--{{#link "contributions" class='element-nav-link link-contributions nav-link'}}
              {{t "activities"}}
            {{/link}}-->
            {{contact_details class='element-nav-link link-contact-details nav-link line-height-normal cursor-pointer'}}
            {{change_password class='element-nav-link link-change-password nav-link line-height-normal cursor-pointer'}}
            {{link "sign_in" class='element-nav-link link-sign-in nav-link'}}
            {{link "sign_out" class='element-nav-link link-sign-out nav-link'}}
          </div>
        {{/if~}}

      </nav>

    </div>

  </header> {{! /.element-header }}

  {{! .layout is closed in the footer.hbs template }}
  
