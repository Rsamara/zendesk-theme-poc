{{! Page container }}
<div class="page-container" id="page-container">

  {{! Notification }}
  {{#if settings.notification_content}}
    {{#isnt (dc settings.notification_content) '#'}}
      <div class="element-notification p-4 font-size-md color-scheme-{{settings.color_scheme_notification}} js-notification" id="notification">
        <script type="text/template">
          <div class="container relative flex align-items-center justify-content-center">
            <% if (icon) { %>
            <span class="element-icon mr-2 <%= icon %> font-size-xl"></span>
            <% } %>
            <div class="element-group font-semibold">
              <%= content %>
            </div>
            <% if (dismissible) { %>
            <button class="element-button not-a-button absolute right-0 p-1 ml-auto cursor-pointer text-inherit hover:text-inherit js-close">
              <span class="fas fa-xmark font-size-lg"></span>
            </button>
            <% } %>
          </div>
        </script>
      </div>
    {{/isnt}}
  {{/if}} {{! /.element-notification }}

  {{! Hero }}
  <div class="element-hero hero{{#if settings.fixed_header}} offset-fixed-header{{/if}}" id="hero">

    {{! Hero content }}
    <div class="hero-content relative z-40 w-full" id="hero-content">

      {{! Container }}
      <div class="element-container container max-w-md text-{{settings.hero_content_alignment}} pb-9 {{#if settings.fixed_header}}pt-7{{else}}pt-9{{/if}} lg:px-0" data-editable>

        {{! Badge }}
        <!--<div class="element-badge badge bg-translucent text-white lg:mt-4">
          <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path>
          </svg>
          AI-powered Support
        </div>-->

        {{! Heading }}
        {{#if settings.hero_heading}}
          <h1 class="element-heading hero-heading mt-2 mb-0 font-size-4xl line-height-1 lg:font-size-5xl" data-editable>
            {{~#if settings.use_translations}}
              {{dc settings.hero_heading}}
            {{else}}
              {{settings.hero_heading}}
            {{/if~}}
          </h1>
        {{/if}} {{! /.element-heading }}

        {{! Paragraph }}
        {{#if settings.hero_text}}
          <p class="element-paragraph mt-2 mb-0 lg:font-size-xl" data-editable>
            {{~#if settings.use_translations}}
              {{dc settings.hero_text}}
            {{else}}
              {{settings.hero_text}}
            {{/if~}}
          </p>
        {{/if}} {{! /.element-paragraph }}

        {{! Search }}
       <!-- <div class="element-search search search-left search-lg mt-6 mb-2 lg:mx-7" data-editable>
          <h2 class="sr-only">{{ t 'search' }}</h2>
          {{~#if settings.search_placeholder}}
            {{#if settings.use_translations}}
              {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_search submit=true placeholder=(dc settings.search_placeholder)}}
            {{else}}
              {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_search submit=true placeholder=settings.search_placeholder}}
            {{/if}}
          {{else}}
            {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_search submit=true}}
          {{/if~}}
          <svg class="search-icon transition" aria-hidden="true">
            <use xlink:href="#icon-search" />
          </svg>
        </div> --> {{! /.element-search }}

       <link rel="icon" type="image/x-icon" href="#">
        <script type="text/javascript" src="https://df1n6ggjt7q61.cloudfront.net/df1c86e67a638bfa5e56b8bd74d06300/search-clients/071f03fd-0c06-11f1-8107-0242ac120004/an.js"></script>
        <script type="text/javascript" src="https://df1n6ggjt7q61.cloudfront.net/df1c86e67a638bfa5e56b8bd74d06300/search-clients/071f03fd-0c06-11f1-8107-0242ac120004/searchbox.js"></script>
        <link rel="stylesheet" href="https://df1n6ggjt7q61.cloudfront.net/df1c86e67a638bfa5e56b8bd74d06300/search-clients/071f03fd-0c06-11f1-8107-0242ac120004/searchbox.css">
        <div id="auto">
            <div ng-controller="SearchautoController">
              <div bind-html-compile="autocompleteHtml"></div>
            </div>
        </div>

        {{! Popular keywords }}
        {{~#isnt settings.popular_keywords_style 'none'}}
          {{~#if settings.popular_keywords}}
            <div class="element-popular-keywords popular-keywords js-popular-keywords" id="popular-keywords">

              {{! Links }}
              {{~#is settings.popular_keywords_style 'links'}}
                <script type="text/template" id="tmpl-popular-keywords">
                  <% const parsedKeywords = Util.parsePopularKeywords(keywords); %>
                  <div class="inline-flex flex-wrap align-items-center justify-content-center m-1 font-size-md">
                    {{#if settings.popular_keywords_heading}}
                      <p class="element-paragraph m-1">
                        {{#if settings.use_translations}}
                          {{dc settings.popular_keywords_heading}}
                        {{else}}
                          {{settings.popular_keywords_heading}}
                        {{/if}}
                      </p>
                    {{/if}}
                    <div class="flex flex-wrap align-items-center">
                      <% parsedKeywords.forEach((keyword, index) => { %>
                        <div class="flex align-items-center m-1">
                          <a
                            class="element-link inline-block text-inherit hover:text-inherit"
                            href="<%= keyword.html_url %>"
                            title="<%= keyword.title %>">
                            <%= keyword.title %>
                          </a><% if (index !== (parsedKeywords.length - 1)) { %>,<% } %>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </script>
              {{/is~}}

            </div>
          {{/if~}}
        {{/isnt~}} {{! /.element-popular-keywords }}

      </div> {{! /.element-container }}

      {{! Divider }}
      {{~#isnt settings.hero_element_shape 'none'}}
        <div class="element-divider shape-divider rotate-180" data-target="#page-container [class*='color-scheme-']" id="hero-divider">
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <use xlink:href="#shape-{{settings.hero_element_shape}}" />
          </svg>
        </div>
      {{/isnt~}} {{! / .element-divider }}

    </div>

    {{! Hero background }}
    <div class="hero-background absolute top-0 left-0 h-full w-full">

      {{! Color gradient }}
      {{#is settings.hero_image_style 'gradient'}}
        <div class="hero-background-gradient bg-hero-gradient absolute top-0 left-0 w-full h-full z-10"></div>
      {{/is}}

      {{! Color and/or image }}
      {{#isnt settings.hero_image_style 'gradient'}}

        {{! Background color }}
        <div class="hero-background-overlay bg-hero bg-hero-{{settings.bg_gradient_hero}} absolute top-0 left-0 w-full h-full z-20"></div>

        {{! Background image }}
        {{#isnt settings.hero_image_style 'color'}}
          <div class="hero-background-image bg-home absolute top-0 left-0 w-full h-full z-{{#contains settings.hero_image_style 'overlay'}}30{{else}}10{{/contains}}
            {{~#is settings.hero_image_style 'overlay-pattern'}} bg-contain bg-repeat{{else}} bg-cover bg-center{{/is~}}"
            {{~#is settings.hero_image_style 'parallax'}} x-data="parallax"{{/is}}>
          </div>
        {{/isnt}}

      {{/isnt}}

    </div>

  </div> {{! /.element-hero }}

  {{! Service actions }}
  <div class="element-group service-actions py-7 bg-subtle">
    <div class="element-container container">
      <div class="md:mt-6" id="service-actions">

        <script type="text/template" id="tmpl-service-actions">

          <div class="element-row row col-gap-md">
            <% blocks.forEach(block => { %>
              <div class="element-column col-12 md:col-6 lg:col-4">
                <div class="element-card card p-6 align-items-start justify-content-start h-full transition hover:shadow hover:float">
                  <% if (block.image_width) { %>
                    <a class="link-stretched element-link inline-flex p-3 align-items-center justify-content-center border-radius-lg text-<%= block.color %> bg-<%= block.color %>" href="<%= block.html_url %>">
                      <img
                        class="element-image img-fluid flex-shrink-0"
                        style="width: <%= block.image_width %>; height: auto;"
                        src="<%= block.image %>"
                        alt="<%= block.name %>"
                        x-data="inlineSVG"
                      />
                    </a>
                  <% } %>
                  <h3 class="element-heading mt-4 mb-3">
                    <a class="element-link link-stretched text-inherit hover:no-underline hover:text-inherit<% if (!block.html_url) { %> pointer-events-none<% } %>" href="<%= block.html_url %>" x-data="link">
                      <%= block.name %>
                    </a>
                  </h3>
                  <% if (block.description) { %>
                    <p class="element-paragraph mb-6 text-subtle">
                      <%= block.description %>
                    </p>
                  <% } %>
                  <a class="button button-brand mt-auto w-full" href="<%= block.html_url %>">
                    <%= block.label %>
                  </a>
                </div>
              </div>
            <% }) %>
          </div>

          <!--<div class="cta card align-items-center px-6 py-7 mt-5 text-center md:flex-row md:text-left">
            <div class="inline-flex p-4 align-items-center justify-content-center border-radius-lg text-<%= cta.color %> bg-<%= cta.color %>">
              <img
                class="element-image img-fluid flex-shrink-0"
                style="width: <%= cta.image_width %>; height: auto;"
                src="<%= cta.image %>"
                alt="<%= cta.name %>"
                x-data="inlineSVG"
              />
            </div>
            <div class="flex-1 my-5 md:my-0 md:mx-5">
              <h3 class="my-0 md:font-size-2xl">
                <%= cta.name %>
              </h3>
              <p class="mt-2 mb-0">
                <%= cta.description %>
              </p>
            </div>
            <a class="button button-brand button-lg" href="<%= cta.html_url %>">
              <%= cta.label %>
            </a>
          </div>-->

        </script>

        <script type="application/javascript">
        document.addEventListener('DOMContentLoaded', function() {

          // Locale-based reference guide URLs, keyed by the user's Zendesk profile locale (data.user.locale)
          var referenceGuideUrls = {
            'en-us': 'https://hunterdouglas.dcatalog.com/',
            'en-ca': 'https://hunterdouglasca.dcatalog.com/',
            'fr-ca': 'https://hunterdouglasca.dcatalog.com/fr/'
          };
          var defaultReferenceGuideUrl = 'https://hunterdouglas.dcatalog.com/';

          function urlForLocale(locale) {
            var key = (locale || '').toLowerCase();
            return referenceGuideUrls[key] || defaultReferenceGuideUrl;
          }

          var el = document.getElementById('service-actions');

          var allBlocks = [
            {
              name: 'Create Ticket',
              description: 'Submit a ticket to support',
              label: 'Create a Ticket',
              html_url: '/hc/en-us/requests/new?ticket_form_id=47856934199956',
              image: '{{asset 'image-quick-action-2.svg'}}',
              image_width: '28px',
              color: 'blue',
            },
            {
              name: 'View Tickets',
              description: 'Check your open tickets',
              label: 'View Tickets',
              html_url: '/hc/en-us/requests',
              image: '{{asset 'image-quick-action-1.svg'}}',
              image_width: '28px',
              color: 'green',
            },
            {
              name: 'HD Reference Guides',
              description: 'Access branded reference guides',
              label: 'Reference Guides',
              html_url: null, // filled in below once we know the user's locale
              image: '{{asset 'image-quick-action-4.svg'}}',
              image_width: '28px',
              color: 'amber',
              // Hide this tile entirely when the user's organization Branding
              // custom field is set to 'al' (Alta) -- the Alta tile below is
              // shown for that organization instead.
              orgRestriction: {
                field: 'branding',
                excludeValues: ['al']
              }
            },
          	{
              name: 'Alta Reference Guides',
              description: 'Access branded reference guides',
              label: 'Reference Guides',
              html_url: null, // filled in below once we know the user's locale
              image: '{{asset 'image-quick-action-4.svg'}}',
              image_width: '28px',
              color: 'amber',
            },          	
            {
              name: 'Newsroom',
              description: 'Access the latest announcements',
              label: 'Newsroom',
              html_url: 'https://hunterdouglassb-hd.sabacloud.com',
              image: '{{asset 'image-service-action-4.svg'}}',
              image_width: '28px',
              color: 'blue',
            },
            {
              name: 'Installer Events',
              description: 'Register for upcoming installer training events',
              label: 'Eventbrite',
              html_url: 'https://www.eventbrite.com/o/hunter-douglas-121302968250',
              image: '{{asset 'image-quick-action-5.svg'}}',
              image_width: '28px',
              color: 'green',
            },
            {
              name: 'Learning Center',
              description: 'Explore training and learning resources',
              label: 'Learning Center',
              html_url: 'https://hunterdouglassb.sabacloud.com/Saba/Web_wdk/NA1TNB0166/index/prelogin.rdf?bdr=true',
              image: '{{asset 'image-quick-action-4.svg'}}',
              image_width: '28px',
              color: 'amber',
            },
            {
              name: 'Brite Pay Help',
              description: 'Help and Resources for Brite Pay',
              label: 'Brite Pay Help',
              html_url: 'https://hunterdouglas-dealer1775168019.zendesk.com/hc/en-us/p/brite_pay',
              image: '{{asset 'image-quick-action-3.svg'}}',
              image_width: '28px',
              color: 'green',
              restriction: {
                field: 'brite_pay_pilot',
                values: [true]
              }
            }
          ];

          var cta = {
            name: 'Technical Support & Troubleshooting',
            description: 'Access advanced troubleshooting resources for technical and motorization support',
            label: 'Try Product Assist',
            html_url: '#',
            image: '{{asset 'image-service-action-4.svg'}}',
            image_width: '32px',
            color: 'red',
          };

          // The "Branding" field that decides whether the HD Reference Guides tile
          // should be hidden does NOT live on the organization record itself -- it
          // lives on a related custom object record (sales_area_data), connected to
          // the organization via the "dealer_account" lookup relationship field.
          //
          // NOTE: Zendesk's filtered-search endpoint for custom object records
          // (POST .../records/search with a "custom_object_fields.<key>": {"$eq": ...}
          // filter) doesn't document the exact value format a lookup relationship
          // field expects, and in testing it was returning zero records even though
          // matching sales_area_data records exist. So instead this pulls the
          // sales_area_data records directly (a plain, well-documented GET/list call)
          // and matches the dealer_account field to the organization on the client
          // side, tolerating a few different formats Zendesk might return for a
          // lookup field's value (a ZRN string like "zen:organization:12345", a plain
          // numeric id, or an object like {"id": 12345, ...}).
          function normalizeLookupId(value) {
            if (value === null || value === undefined) return null;
            if (typeof value === 'object') {
              // e.g. { id: 12345, url: '...' }
              if (value.id !== undefined && value.id !== null) return String(value.id);
              return null;
            }
            var str = String(value);
            var match = str.match(/(\d+)\s*$/); // pulls the trailing id out of "zen:organization:12345" or "12345"
            return match ? match[1] : str;
          }

          function fetchAllSalesAreaRecords(cursor, accumulated, pagesFetched) {
            accumulated = accumulated || [];
            pagesFetched = pagesFetched || 0;
            var MAX_PAGES = 10; // safety cap: 10 x 100 = up to 1000 records
            var url = '/api/v2/custom_objects/sales_area_data/records?page[size]=100' + (cursor ? '&page[after]=' + encodeURIComponent(cursor) : '');
            return fetch(url, { credentials: 'same-origin' })
              .then(function (res) { return res.json(); })
              .then(function (data) {
                var records = (data && data.custom_object_records) || [];
                var all = accumulated.concat(records);
                var meta = (data && data.meta) || {};
                pagesFetched += 1;
                if (meta.has_more && meta.after_cursor && pagesFetched < MAX_PAGES) {
                  return fetchAllSalesAreaRecords(meta.after_cursor, all, pagesFetched);
                }
                if (meta.has_more && pagesFetched >= MAX_PAGES) {
                  console.warn('sales_area_data: hit the ' + MAX_PAGES + '-page safety cap; some records were not checked.');
                }
                return all;
              });
          }

          function fetchDealerBranding(organizationId, csrfToken) {
            if (!organizationId) {
              return Promise.resolve(null);
            }
            return fetchAllSalesAreaRecords()
              .then(function (allRecords) {
                console.log('sales_area_data total records fetched:', allRecords.length);
                if (allRecords[0]) {
                  // Sample record so we can see the real shape of dealer_account / branding in the console.
                  console.log('sales_area_data sample record:', allRecords[0]);
                }

                var orgIdStr = String(organizationId);
                var matches = allRecords.filter(function (record) {
                  var fields = (record && record.custom_object_fields) || {};
                  var normalized = normalizeLookupId(fields.dealer_account);
                  return normalized === orgIdStr;
                });
                console.log('sales_area_data records matching org ' + organizationId + ':', matches);

                if (!matches.length) return null;

                // If more than one related record exists, treat the org as Alta-branded
                // if ANY of them are flagged 'al'.
                var alRecord = matches.filter(function (record) {
                  var fields = (record && record.custom_object_fields) || {};
                  var value = (fields.branding || '').toString().trim().toLowerCase();
                  return value === 'al';
                })[0];
                return alRecord ? 'al' : (matches[0].custom_object_fields && matches[0].custom_object_fields.branding) || null;
              })
              .catch(function (err) {
                console.error('Failed to fetch sales_area_data branding for org ' + organizationId + ':', err);
                return null; // Fail open: HD Reference Guides stays visible if the lookup fails
              });
          }

          // Single request: pulls both the reference-guide locale and the custom fields
          // used for restriction checks (e.g. brite_pay_pilot) straight from the Zendesk user record.
          fetch('/api/v2/users/me.json?include=organizations', {credentials: 'same-origin'})
            .then(function (res) { return res.json(); })
            .then(function (data) {
              var user = (data && data.user) || {};
          		var organizations = (data && data.organizations) || [];
              var userFields = user.user_fields || {};

          		var org = organizations.filter(function (o) { return o.id === user.organization_id; })[0] || organizations[0] || {};
          		var orgFields = org.organization_fields || {};

              var referenceGuideUrl = urlForLocale(user.locale);
          		console.log(referenceGuideUrl)
          		console.log(data.user.locale)
          		console.log(user.name)
          		console.log(data.user)
          		console.log(orgFields)
          		console.log('organizations returned:', organizations)

              return fetchDealerBranding(user.organization_id, user.authenticity_token).then(function (brandingValue) {
                console.log('resolved dealer branding value:', brandingValue);

                var blocksWithUrl = allBlocks.map(function (block) {
                  if (block.name === 'HD Reference Guides' || block.name === 'Alta Reference Guides') {
                    return Object.assign({}, block, { html_url: referenceGuideUrl });
                  }
                  return block;
                });

                var templateData = {
                  blocks: blocksWithUrl.filter(function (block) {
                    // Organization-level restriction: hide HD Reference Guides when the
                    // related sales_area_data record's Branding field is 'al' (Alta).
                    if (block.orgRestriction) {
                      var normalizedBranding = (brandingValue || '').toString().trim().toLowerCase();
                      if (block.orgRestriction.excludeValues.indexOf(normalizedBranding) !== -1) {
                        return false;
                      }
                    }
                    if (!block.restriction) return true; // No restriction = show for everyone
                    var fieldValue = userFields[block.restriction.field];
                    return block.restriction.values.indexOf(fieldValue) !== -1;
                  }),
                  cta: cta
                };

                Util.renderTemplate(el, 'service-actions', templateData);
              });
            })
            .catch(function (err) {
              console.error('Failed to fetch user record:', err);
              // Fail-safe: default reference guide URL, restricted blocks hidden, unauthenticated visitors included
              var blocksWithUrl = allBlocks.map(function (block) {
                if (block.name === 'HD Reference Guides' || block.name === 'Alta Reference Guides') {
                  return Object.assign({}, block, { html_url: defaultReferenceGuideUrl });
                }
                return block;
              });
              var templateData = {
                blocks: blocksWithUrl.filter(function (block) { return !block.restriction; }),
                cta: cta
              };
              Util.renderTemplate(el, 'service-actions', templateData);
            });

        });
          
         
      </script>

      </div>
    </div>
  </div>

