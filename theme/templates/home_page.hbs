  {{! Category list }}
  {{#isnt settings.content_block_style 'none'}}
    <div class="element-category-list category-list color-scheme-{{settings.color_scheme_content_blocks}}" id="category-list">

      {{! Card style }}
      {{#is settings.content_block_style 'cards'}}
        <div class="element-group bg-subtle py-7">
          <div class="element-container container relative z-10">

            {{! Heading }}
            {{#if settings.content_blocks_heading}}
              <h2 class="element-heading mt-0 mb-3 lg:font-size-3xl">
                {{#if settings.use_translations}}
