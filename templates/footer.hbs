{{! Article list }}
{{~#contains (concat settings.category_sidebar settings.section_sidebar settings.article_sidebar) 'article-list'}}
  <script type="text/template" id="tmpl-sidebar-article-list">
    <% const breakpoint = get('breakpoint', 'lg'); %>
    <% const activeSectionId = get('activeSectionId', null); %>
    <div
      class="element-group mt-5 border-top border-bottom <%= breakpoint %>:border-0 <%= breakpoint %>:mb-7{{#isnt settings.animations 'none'}} animation animated animation:{{settings.animations}}{{/isnt}}"
      x-data="navigation({ categories: [], sections: [],<% if (activeSectionId) { %> articles: { section_id: <%= activeSectionId %> }<% } %> })">
      <div x-data="collapse({ breakpoint: '<%= breakpoint %>' })">
        <h3 class="element-heading flex align-items-center justify-content-between my-3 font-size-lg <%= breakpoint %>:hidden" x-bind="trigger">
          <%= Theme.l18n.categories %>
          <svg class="svg-icon pointer-events-none ml-3 <%= breakpoint %>:hidden"  :class="(isExpanding || isExpanded) && 'rotate-180'" aria-hidden="true">
            <use xlink:href="#icon-chevron-down" />
          </svg>
        </h3>
        <div class="collapse" x-bind="collapse">
          <ul class="element-list list-unstyled mb-0" x-show="!loading && categories.length">
            <template x-for="(category, index) in categories" :key="category.id">
              <li
                :class="{ 'border-bottom': index < categories.length - 1, 'is-selected': category.isActive }"
                x-html="await renderTemplate('sidebar-article-list-category-item', { categoryId: category.id })">
              </li>
            </template>
          </ul>
        </div>
      </div>
    </div>
  </script>
  <script type="text/template" id="tmpl-sidebar-article-list-category-item">
    <div class="flex align-items-center">
      <a
        class="element-nav-link flex-1 py-3 font-size-lg font-bold text-heading hover:text-brand hover:no-underline"
        :class="{ 'text-brand is-selected': category.isActive }"
        :href="category.html_url"
        x-text="category.name"
        x-on:click="toggleItem($event, category.id)">
      </a>
    </div>
    <div class="collapse" :id="category.id" x-show="!isLoading(category.id)">

      {{! Sections }}
      <div x-show="hasItems(category.sections)">
        <ul class="element-list list-unstyled pb-3 mb-0 font-size-md">
          <template x-for="section<%= categoryId %> in category.sections" :key="section<%= categoryId %>.id">
            <li
              x-html="await renderTemplate('sidebar-article-list-section-item', {
                categoryId: <%= categoryId %>,
                sectionId: section<%= categoryId %>.id
              })">
            </li>
          </template>
        </ul>
      </div>
    </div>
  </script>
  <script type="text/template" id="tmpl-sidebar-article-list-section-item">
    <div class="relative flex align-items-center">
      <a
        class="element-nav-link block py-1 text-base font-medium hover:text-brand hover:no-underline"
        :class="{ 'font-semibold text-brand is-selected': section<%= categoryId %>.isActive }"
        :href="section<%= categoryId %>.html_url"
        x-text="section<%= categoryId %>.name"
        x-on:click="toggleItem($event, section<%= categoryId %>.id)">
      </a>
      <span class="inline-loader ml-2" x-show="isLoading(section<%= categoryId %>.id)"></span>
    </div>
    <div class="collapse" :id="section<%= categoryId %>.id" x-show="!isLoading(section<%= categoryId %>.id)">

      {{! Subsections }}
      <div x-show="hasItems(section<%= categoryId %>.sections)">
        <div class="element-group py-1 pl-3 mb-0">
          <ul class="list-unstyled mb-0">
            <template x-for="section<%= sectionId %> in section<%= categoryId %>.sections" :key="section<%= sectionId %>.id">
              <li
                x-html="await renderTemplate('sidebar-article-list-section-item', {
                  categoryId: <%= sectionId %>,
                  sectionId: section<%= sectionId %>.id
                })">
              </li>
            </template>
          </ul>
        </div>
      </div>

      {{! Articles }}
      <div x-show="hasItems(section<%= categoryId %>.articles)">
        <ul class="element-list list-unstyled pl-3 pt-1 pb-2 mb-0 font-size-sm">
          <template x-for="article<%= sectionId %> in section<%= categoryId %>.articles" :key="article<%= sectionId %>.id">
            <li>
              <a
                class="element-nav-link block pl-3 py-1 text-base border-left border-left-3 transition hover:border-left-brand hover:text-brand hover:no-underline"
                :class="{ 'text-brand border-brand is-selected': article<%= sectionId %>.isActive }"
                :href="article<%= sectionId %>.html_url"
                x-text="article<%= sectionId %>.title">
              </a>
            </li>
          </template>
        </ul>
      </div>
    </div>
  </script>
{{/contains~}}

{{! Section list }}
{{~#contains (concat settings.category_sidebar settings.section_sidebar settings.article_sidebar) 'section-list'}}
  <script type="text/template" id="tmpl-sidebar-section-list">
    <% breakpoint = get('breakpoint', 'lg'); %>
    <% activeSectionId = get('activeSectionId', null); %>
    <div
      class="element-group mt-5 border-top border-bottom <%= breakpoint %>:border-0 <%= breakpoint %>:mt-6 <%= breakpoint %>:mb-7{{#isnt settings.animations 'none'}} animation animated animation:{{settings.animations}}{{/isnt}}"
      x-data="navigation({ categories: [], sections: [],<% if (activeSectionId) { %> articles: { section_id: <%= activeSectionId %> }<% } %> })">
      <div x-data="collapse({ breakpoint: '<%= breakpoint %>' })">
        <h3
          class="element-heading flex align-items-center justify-content-between my-3 font-size-lg <%= breakpoint %>:hidden"
          x-bind="trigger">
          <%= Theme.l18n.toggleNavigation %>
          <svg class="svg-icon bottom-0 ml-1" :class="{ 'rotate-180': (isExpanding || isExpanded) }" aria-hidden="true">
            <use xlink:href="#icon-chevron-down" />
          </svg>
        </h3>
        <div class="collapse" x-bind="collapse">
          <ul class="element-list list-unstyled mb-0 w-full mr-5" x-show="!loading && categories.length">
            <template x-for="(category, index) in categories" :key="category.id">
              <li
                x-html="await renderTemplate('section-list-category-item', {
                  categoryId: category.id,
                  breakpoint: '<%= breakpoint %>'
                })">
              </li>
            </template>
          </ul>
        </div>

      </div>
    </div>
  </script>
  <script type="text/template" id="tmpl-section-list-category-item">
    <% const maxSections = get('maxSections', 5); %>
    <a
      class="element-nav-link hidden py-2 font-bold font-size-lg text-heading hover:text-brand <%= breakpoint %>:block"
      :class="{ 'text-brand is-selected': category.isActive }"
      :href="category.html_url"
      x-text="category.name">
    </a>
    {{! Sections }}
    <div x-show="category.isActive && hasItems(category.sections)">
      <ul class="element-list list-unstyled py-1 font-size-md border-radius <%= breakpoint %>:px-5 <%= breakpoint %>:py-3 <%= breakpoint %>:my-1 <%= breakpoint %>:mr-5 <%= breakpoint %>:bg-subtle">
        <template x-for="section<%= categoryId %> in category.sections.slice(0, <%= maxSections %>)" :key="section<%= categoryId %>.id">
          <li
            x-html="await renderTemplate('section-list-section-item', {
              categoryId: <%= categoryId %>,
              sectionId: section<%= categoryId %>.id
            })">
          </li>
        </template>
        <li x-show="category.sections.length > <%= maxSections %>">
          <a class="element-nav-link flex align-items-center py-1 text-base hover:text-base" :href="category.html_url">
            <span x-text="Util.i18n('more')"></span>
            <svg class="svg-icon bottom-0 ml-1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </script>
  <script type="text/template" id="tmpl-section-list-section-item">
    <a
      class="element-nav-link block py-2 text-base"
      :class="{ 'font-semibold text-heading is-selected': section<%= categoryId %>.isActive }"
      :href="section<%= categoryId %>.html_url"
      x-text="section<%= categoryId %>.name">
    </a>

      {{! Subsections }}
    <div x-show="hasItems(section<%= categoryId %>.sections)">
      <ul class="element-list list-unstyled mb-0 pl-3 font-size-sm">
        <template x-for="section<%= sectionId %> in section<%= categoryId %>.sections" :key="section<%= sectionId %>.id">
          <li
            x-html="await renderTemplate('section-list-section-item', {
              categoryId: <%= sectionId %>,
              sectionId: section<%= sectionId %>.id
            })">
          </li>
        </template>
      </ul>
    </div>
  </script>
{{/contains~}}

