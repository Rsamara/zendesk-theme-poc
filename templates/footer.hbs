{{! Hero navigation }}
<script type="text/template" id="tmpl-navigation-hero">
  <% breakpoint = get('breakpoint', 'md'); %>
  <% activeSectionId = get('activeSectionId', null); %>
  <div x-data="navigation({ categories: [], sections: [],<% if (activeSectionId) { %> activeSectionId: <%= activeSectionId %><% } %> })">

    {{! Categories }}
    <div class="element-group my-5 <%= breakpoint %>:scroll-x">
      <nav class="element-nav nav flex-no-wrap white-space-no-wrap <%= breakpoint %>:flex-wrap">
        <template x-for="category in categories" :key="category.id">
          <a
            class="element-nav-link nav-link mb-1 border-radius font-size-md"
            :class="{
              'text-brand-inverse bg-brand font-semibold hover:text-brand-inverse hover:bg-brand is-selected': category.isActive,
              'text-base font-medium hover:text-base hover:bg-translucent': !category.isActive
            }"
            :aria-selected="category.isActive"
            :href="category.html_url"
            x-text="category.name">
          </a>
        </template>
      </nav>
    </div>

  </div>
</script>

