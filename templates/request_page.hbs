{{! Page container }}
<div class="page-container" id="page-container">

  {{! Container }}
  <div class="element-container container" data-editable>

    {{! Row }}
    <div class="element-row row align-items-center my-6" data-editable>

      {{! Column }}
      <div class="element-column col-12{{#is settings.header_search_style 'none'}} md:col-8{{/is}}" data-editable>

        {{! Breadcrumbs }}
        <div class="element-breadcrumbs breadcrumbs mb-3 md:m-0 js-breadcrumbs" id="breadcrumbs">
          {{breadcrumbs}}
        </div> {{! / .element-breadrcumbs }}

      </div> {{! / .element-column }}

      {{! Column }}
      <div class="element-column col-12 md:col-4 empty:hidden" data-editable>

        {{! Search }}
        {{~#is settings.header_search_style 'none'}}
          <div class="element-search search search-left" data-editable>
            <h2 class="sr-only">{{t 'search' }}</h2>
            {{~#if settings.search_placeholder}}
              {{#if settings.use_translations}}
                {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_search submit=false placeholder=(dc settings.search_placeholder)}}
              {{else}}
                {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_search submit=false placeholder=settings.search_placeholder}}
              {{/if}}
            {{else}}
              {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_search submit=false}}
            {{/if~}}
            <svg class="search-icon transition" aria-hidden="true">
              <use xlink:href="#icon-search" />
            </svg>
          </div>
        {{/is~}} {{! / .element-search }}

      </div> {{! / .element-column }}

    </div> {{! / .element-row }}

    {{! Heading }}
    <h1 class="element-heading my-4" data-editable>
      {{request.subject}}
    </h1> {{! / .element-heading }}

    {{! Row }}
    <div class="element-row row col-gap-x-lg" data-editable>

      {{! Column (content) }}
      <div class="element-column col" data-editable>

        {{! Comment list }}
        <div class="element-comment-list mb-7" itemscope itemtype="http://schema.org/UserComments" data-editable>

          {{satisfaction}}

          {{! Comments }}
          {{#if comments}}
            <ul class="comment-list list-unstyled mb-0">
              {{#each comments}}
                <li class="comment py-5{{#if @first}} border-top{{/if}} border-bottom" id="{{anchor}}">

                  {{! Comment author }}
                  <div class="element-author comment-author media mb-4">

                    <div class="element-avatar avatar mr-2">
                      {{#if author.agent}}
                        <svg class="svg-icon absolute bottom-0 right-0 text-brand bg-base border border-white circle" aria-hidden="true">
                          <use xlink:href="#icon-agent" />
                        </svg>
                      {{/if}}
                      <img class="avatar-img" src="{{author.avatar_url}}" alt="Comment author" />
                    </div>

                    <div class="media-body">

                      <div title="{{author.name}}">
                        {{#link 'user_profile' class='element-link font-size-md' id=author.id}}
                          {{author.name}}
                        {{/link}}
                      </div>

                      <ul class="list-divider mb-0">
                        <li>
                          <p class="element-paragraph inline my-0 font-size-sm text-subtle">
                            {{date created_at}}
                          </p>
                        </li>
                      </ul>
                    </div>

                  </div> {{! / .element-author }}

                  {{! Content }}
                  <div class="element-content request-content content">
                    {{body}}
                  </div> {{! / .element-content }}

                  {{! Attachments }}
                  <div class="element-attachments">
                    {{#if attachments}}
                      <ul class="attachments list-unstyled">
                        {{#each attachments}}
                          <li class="list-item">
                            <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true">
                              <path fill="none" stroke="currentColor" stroke-linecap="round" d="M9.5 4v7.7c0 .8-.7 1.5-1.5 1.5s-1.5-.7-1.5-1.5V3C6.5 1.6 7.6.5 9 .5s2.5 1.1 2.5 2.5v9c0 1.9-1.6 3.5-3.5 3.5S4.5 13.9 4.5 12V4"/>
                            </svg>
                            <a class="element-link mr-2 font-size-md text-subtle" href="{{url}}" target="_blank">{{name}}</a>
                            <span class="font-size-md text-subtle">{{size}}</span>
                          </li>
                        {{/each}}
                      </ul>
                    {{/if}}
                  </div> {{! / .element-attachments }}

                </li>
              {{/each}}
            </ul>
          {{/if}}

          {{! Pagination }}
          {{#if pagination}}
            <div class="element-pagination pagination my-6 js-pagination">
              {{pagination}}
            </div>
          {{/if}}

          {{! Paragraph }}
          <p class="element-paragraph">
            {{comment_callout}}
          </p>

        </div> {{! / .element-comment-list }}

        {{! Form }}
        <div class="element-form mt-6 mb-8" data-editable>
          {{#form 'comment' class='comment-form form'}}
            <div class="element-group flex" x-data="commentField">

              <div class="element-avatar avatar mr-3 hidden md:block">
                {{user_avatar class='avatar-img'}}
              </div>

              <div class="flex-1">

                <div class="p-3 border border-radius font-size-md bg-base cursor-pointer" :class="{ 'hidden': isVisible }" @click="show">
                  {{t 'add_to_conversation'}}
                </div>

                <div :class="{ 'hidden': !isVisible }">
                  {{#if help_center.request_ccs_enabled}}
                    <div class="comment-ccs form-field mb-3">
                      {{token_field 'ccs' class='ccs-input'}}
                    </div>
                  {{/if}}
                  <div class="form-field mb-3">
                    {{wysiwyg 'body' rows='7'}}
                  </div>
                  <div class="my-3">
                    {{upload}}
                  </div>
                  <div class="flex align-items-center justify-content-end">
                    {{#if request.can_be_marked_as_solved}}
                      {{checkbox 'mark_as_solved' class='hidden'}}
                      <button
                        class="button button-outline-brand mr-2 js-mark-as-solved"
                        type="button"
                        data-solve-translation="{{t 'mark_as_solved'}}"
                        data-solve-and-submit-translation="{{t 'mark_as_solved_and_submit'}}">
                        {{t 'mark_as_solved'}}
                      </button>
                    {{/if}}
                    {{input class='button button-brand align-self-end' type='submit'}}
                  </div>
                </div>

              </div>
            </div>
          {{/form}}
        </div> {{! / .element-form }}

      </div> {{! / .element-column }}

      {{! Sidebar right }}
      <aside class="element-sidebar sidebar flex-first lg:flex-last lg:sidebar-lg lg:sidebar-right lg:sidebar-sticky empty:hidden" x-data="sidebar" data-editable>

        {{! Request details }}
        <div class="element-request-details py-4 border-top lg:p-5 lg:m-0 lg:border-transparent lg:bg-subtle" x-data="collapse({ breakpoint: 'lg' })" data-editable>
          <h3 class="element-heading flex align-items-center justify-content-between my-0 font-size-lg" x-bind="trigger">
            {{t 'ticket_details'}}
            <svg class="svg-icon ml-1 bottom-0" :class="{ [`${breakpoint}:hidden`]: true, 'rotate-180': (isExpanding || isExpanded) }" aria-hidden="true">
              <use xlink:href="#icon-chevron-down" />
            </svg>
          </h3>
          <div class="collapse pt-4 font-size-sm" x-bind="collapse">

            {{#if request.followup_source_id}}
              <dl class="row col-gap-0">
                <dt class="col-5 mb-4">
                  {{t 'followup'}}
                </dt>
                <dd class="col-7">
                  {{link 'request' id=request.followup_source_id}}
                </dd>
              </dl>
            {{/if}}

            <dl class="element-row row col-gap-0 mb-0">
              {{#with satisfaction_response}}
                {{#with rating}}
                  <dt class="col-5 mb-4">
                    {{t 'rating'}}
                  </dt>
                  <dd>
                    <div>
                      {{#is scale_type 'numeric'}}
                        {{t 'numerical_rating' value=value max_value=max_value}}
                      {{else}}
                        {{scale_value}}
                      {{/is}}
                    </div>
                    {{#link 'survey_response' id=../id}}
                      {{#if ../editable}}
                        {{t 'edit_feedback'}}
                      {{else}}
                        {{t 'view_feedback'}}
                      {{/if}}
                    {{/link}}
                  </dd>
                {{else}}
                  {{#if editable}}
                    <dt class="col-5 mb-4">
                      {{t 'rating'}}
                    </dt>
                    <dd>
                      {{#link 'survey_response' id=id}}
                        {{t 'add_feedback'}}
                      {{/link}}
                    </dd>
                  {{/if}}
                {{/with}}
              {{/with}}
              <dt class="col-5 mb-4">
                {{t 'id'}}
              </dt>
              <dd class="col-7">
                #{{request.id}}
              </dd>
              <dt class="col-5 mb-4">
                {{t 'status'}}
              </dt>
              <dd class="col-7">
                <span class="badge badge-{{request.status}} align-middle font-size-xs ml-1" title="{{request.status_description}}">
                  {{request.status_name}}
                </span>
              </dd>
              <dt class="col-5 mb-4">
                {{t 'requester'}}
              </dt>
              <dd class="col-7">
                {{request.requester.name}}
              </dd>
              <dt class="col-5 mb-4">
                {{t 'created'}}
              </dt>
              <dd class="col-7">
                {{date request.created_at}}
              </dd>
              <dt class="col-5 mb-4">
                {{t 'last_activity'}}
              </dt>
              <dd class="col-7">
                {{date request.updated_at}}
              </dd>
              {{#if collaborators}}
                <dt class="col-5 mb-4">
                  {{t 'ccs'}}
                </dt>
                <dd class="col-7">
                  <ul class="list-unstyled m-0">
                    {{#each collaborators}}
                      <li title="{{name}}">
                        {{name}}
                      </li>
                    {{/each}}
                  </ul>
                </dd>
              {{/if}}
              {{#if assignee}}
                <dt class="col-5 mb-4">
                  {{t 'assignee'}}
                </dt>
                <dd class="col-7">
                  {{assignee.name}}
                </dd>
              {{/if}}
              {{#if group}}
                <dt class="col-5 mb-4">
                  {{t 'group'}}
                </dt>
                <dd class="col-7">
                  {{group.name}}
                </dd>
              {{/if}}
              {{#if request.type}}
                <dt class="col-5 mb-4">
                  {{t 'type'}}
                </dt>
                <dd class="col-7">
                  {{request.type_name}}
                  {{#is request.type 'task'}}
                    {{t 'task_due_date' due_date=request.due_date}}
                  {{/is}}
                </dd>
              {{/if}}
              {{#if request.priority}}
                <dt class="col-5 mb-4">
                  {{t 'priority'}}
                </dt>
                <dd class="col-7">
                  {{request.priority_name}}
                </dd>
              {{/if}}
              {{#form 'organization' class='col-12 form w-full' id='request-organization'}}
                <div class="row col-gap-sm">
                  <dt class="col-5 mb-4">
                    {{t 'organization'}}
                  </dt>
                  <dd class="col-7 form-field mb-4">
                    {{select 'organization'}}
                  </dd>
                </div>
              {{/form}}
              {{#each custom_fields}}
                <dt class="col-5 mb-4">
                  {{title}}
                </dt>
                <dd class="col-7">
                  {{value}}
                </dd>
              {{/each}}
            </dl>

            {{! Attachments }}
            {{#if attachments}}
              <dl class="pt-6 pb-2 border-top">
                <dt class="mb-4">
                  {{t 'attachments_heading'}}
                </dt>
                <dd>
                  <ul class="element-list list-unstyled mb-0">
                    {{#each attachments}}
                      <li class="mb-4">
                        <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true">
                          <path fill="none" stroke="currentColor" stroke-linecap="round" d="M9.5 4v7.7c0 .8-.7 1.5-1.5 1.5s-1.5-.7-1.5-1.5V3C6.5 1.6 7.6.5 9 .5s2.5 1.1 2.5 2.5v9c0 1.9-1.6 3.5-3.5 3.5S4.5 13.9 4.5 12V4"/>
                        </svg>
                        <a class="element-link mr-2" href="{{url}}" target="_blank">{{name}}</a><span class="font-size-md text-subtle">{{size}}</span>
                      </li>
                    {{/each}}
                  </ul>
                </dd>
              </dl>
            {{/if}}

          </div>
        </div> {{! / .element-request-details }}

      </aside> {{! / .element-sidebar }}

    </div> {{! / .element-row }}

  </div> {{! / .element-container }}

</div> {{! /#page-container }}

<script type="text/javascript" defer src="{{asset 'script-page-request.min.js'}}"></script>

<script type="text/javascript">document.documentElement.classList.add('request-page', 'request-{{request.id}}');</script>