{{! Page container }}
<div class="page-container" id="page-container">

  {{! Group }}
  <div class="element-group py-6 bg-subtle" data-editable>

    {{! Container }}
    <div class="element-container container" data-editable>

      {{! Group }}
      <div class="element-group mb-3 md:flex" data-editable>

        {{! Avatar }}
        <div class="element-avatar avatar avatar-lg mb-3 mr-5" data-editable>
          {{#if user.agent}}
            <svg class="svg-icon absolute bottom-0 right-0 text-brand bg-base border border-white circle" aria-hidden="true">
              <use xlink:href="#icon-agent" />
            </svg>
          {{/if}}
          <img class="avatar-img" src="{{user.avatar_url}}" alt="{{user.name}}" />
        </div> {{! /.element-avatar }}

        {{! User profile }}
        <div class="element-user-profile flex-1 overflow-hidden" title="{{user.name}}" data-editable>
          <div class="md:flex">

            {{! User information }}
            <div class="media-body">
              <h1 class="element-heading mt-0 mb-1 lg:font-size-4xl">
                {{#if user.url}}
                  <a class="element-link text-inherit hover:no-underline" href="{{user.url}}" target="_zendesk_lotus" title="{{t 'open_user_in_support'}}">
                    {{user.name}}
                  </a>
                {{else}}
                  {{user.name}}
                {{/if}}
              </h1>
              {{#if description}}
                <p class="element-paragraph mb-2 font-size-lg">
                  {{description}}
                </p>
              {{/if}}

              {{! Metadata }}
              <ul class="element-list list-divider mb-3">
                <li>
                  <p class="element-paragraph inline my-0 font-size-sm text-subtle">
                    {{#if member_since}}
                      {{t 'member_since'}} {{date member_since format='medium'}}
                    {{else}}
                      {{t 'no_activity_yet'}}
                    {{/if}}
                  </p>
                </li>
                <li>
                  <p class="element-paragraph inline my-0 font-size-sm text-subtle">
                    {{#if last_activity_at}}
                      {{t 'last_activity'}} {{date last_activity_at format='medium'}}
                    {{else}}
                      {{t 'no_activity_yet'}}
                    {{/if}}
                  </p>
                </li>
              </ul>

              {{! Badges }}
              {{#if (compare user.badges.length ">" 0)}}
                <div class="flex align-items-center flex-wrap mb-2 font-size-md" aria-label="{{t 'badges'}}">

                  {{#each (filter user.badges on="category_slug" equals="titles")}}
                    <span class="element-badge badge mr-2 font-size-sm" title="{{description}}" aria-label="{{name}}">
                      {{name}}
                    </span>
                  {{/each}}

                  {{#each (slice (filter user.badges on="category_slug" equals="achievements") 0 4)}}
                    <img class="flex-shrink-0 mr-1" width="18" height="18" src="{{icon_url}}" alt="{{name}}" title="{{name}} | {{description}}" />
                  {{/each}}

                  {{#if (compare (calc user.badges.length "-" 4) ">" 0)}}
                    <a class="ml-1" href="{{page_path "user_profile" id=user.id filter_by="badges"}}" aria-label="{{t 'more_awards_to' count=(calc user.badges.length "-" 4) name=user.name}}">
                      {{t 'plus_more' count=(calc user.badges.length "-" 4)}}
                    </a>
                  {{/if}}

                </div>
              {{/if}}

            </div>

            <div class="element-group flex my-4">

              {{! User actions }}
              <div class="element-actions actions-user js-subscribe" data-class="element-button button button-sm button-brand">
                {{actions}}
              </div>

              {{! Subscribe }}
              {{#if settings.show_subscribe}}
                <div class="element-subscribe subscribe-user ml-3 js-subscribe" data-class="element-button button button-sm button-brand">
                  {{subscribe}}
                </div>
              {{/if}}

            </div>
          </div>

          {{! Statistics }}
          <div class="element-row row col-gap-sm justify-content-start my-0">

            <div class="element-column col-6 md:col-auto">
              <h4 class="my-1 font-size-md">
                {{t 'following_users'}}
              </h4>
              <p class="element-paragraph mb-0 font-size-sm text-subtle">
                {{t 'users_count' count=following_count}}
              </p>
            </div>

            <div class="element-column col-6 md:col-auto">
              <h4 class="my-1 font-size-md">
                {{t 'followed_by'}}
              </h4>
              <p class="element-paragraph mb-0 font-size-sm text-subtle">
                {{t 'users_count' count=follower_count}}
              </p>
            </div>

            <div class="element-column col-6 md:col-auto">
              <h4 class="my-1 font-size-md">
                {{t 'votes'}}
              </h4>
              <p class="element-paragraph mb-0 font-size-sm text-subtle">
                {{vote_count}}
              </p>
            </div>

            <div class="element-column col-6 md:col-auto">
              <h4 class="my-1 font-size-md">
                {{t 'subscriptions'}}
              </h4>
              <p class="element-paragraph mb-0 font-size-sm text-subtle">
                {{subscription_count}}
              </p>
            </div>

            <div class="element-column col-6 md:col-auto">
              <h4 class="my-1 font-size-md">
                {{t 'total_activity'}}
              </h4>
              <p class="element-paragraph mb-0 font-size-sm text-subtle">
                {{total_activity}}
              </p>
            </div>

          </div>

        </div> {{! /.element-user-profile }}

      </div> {{! /.element-group }}

    </div> {{! /.element-container }}

  </div> {{! /.element-group }}

  {{! Group }}
  <div class="element-group border-top border-bottom" data-editable>

    {{! Container }}
    <div class="element-container container" data-editable>

      {{! Filters }}
      {{#if visible}}
        {{#if member_since}}
          <nav class="element-filters nav collapsible-nav font-size-md" x-data="collapsibleNav" data-editable>
            {{#each filters}}
              <a
                class="element-nav-link nav-link pt-4 pb-3 font-medium border-bottom border-bottom-3
                  {{~#unless @last}} md:mr-3{{/unless~}}
                  {{~#if selected}} text-brand border-bottom-brand hover:text-brand is-selected{{/if~}}
                  {{~#unless selected}} border-bottom-transparent hover:text-base hover:border-bottom-base{{/unless~}}"
                {{~#if selected}} aria-current="page" aria-selected="true"{{/if}} href="{{url}}">
                {{name}}
              </a>
            {{/each}}
          </nav>
        {{/if}}
      {{/if}} {{! /.element-filters }}

    </div> {{! /.element-container }}

  </div> {{! /.element-group }}

  {{! Container }}
  <div class="element-container container" data-editable>

    {{! Row }}
    <div class="element-row row" data-editable>

      {{! Column }}
      <div class="element-column col-12 lg:col-11 xl:col-8" data-editable>

        {{! Activity list }}
        {{#if visible}}
          {{#if member_since}}
            {{#is current_filter.identifier 'activities'}}
              <div class="element-activity-list activity-list mb-7" data-editable>
                {{#if activities}}

                  {{! Heading element }}
                  <h2 class="element-heading mt-6 mb-1">
                    {{t 'activity_overview'}}
                  </h2> {{! / .element-heading }}

                  {{! Paragraph element }}
                  <p class="element-paragraph font-size-md text-subtle">
                    {{t 'latest_activity' name=user.name}}
                  </p> {{! / .element-paragraph }}

                  {{! Activities }}
                  <ul class="list-unstyled my-5">
                    {{#each activities}}
                      <li class="activity-item">
                        <svg class="svg-icon bottom-0 mr-2" aria-hidden="true">
                          <use xlink:href="#activity-{{contribution.object_type}}" />
                        </svg>

                        <p class="element-paragraph inline font-size-md my-0">
                          {{label}}
                        </p>

                        {{! Group }}
                        <div class="element-group pl-4 pt-2 pb-4 my-2 ml-2{{#unless @last}} border-left{{/unless}}">

                          {{! Card }}
                          <div class="element-card card p-5 bg-subtle">

                            {{#with contribution}}
                              {{#is object_type 'comment'}}
                                <nav aria-label="Activity location">
                                  <ol class="element-breadcrumbs breadcrumbs">
                                    {{#each path_steps}}
                                      <li title="{{name}}">
                                        <a href="{{url}}">{{name}}</a>
                                      </li>
                                    {{/each}}
                                  </ol>
                                </nav>
                              {{else}}
                                <h3 class="element-heading mt-0 mb-2 font-size-base">
                                  <a class="element-link text-inherit hover:no-underline" href="{{url}}">
                                    {{title}}
                                  </a>
                                </h3>
                                <nav aria-label="Activity location">
                                  <ol class="element-breadcrumbs breadcrumbs mb-2">
                                    {{#each path_steps}}
                                      <li title="{{name}}">
                                        <a href="{{url}}">{{name}}</a>
                                      </li>
                                    {{/each}}
                                  </ol>
                                </nav>
                              {{/is}}

                              {{! Paragraph }}
                              <p class="element-paragraph font-size-md">
                                {{excerpt body characters=200}}
                              </p> {{! / .element-paragraph }}

                              {{! Activity metadata }}
                              <ul class="list-divider mb-0">
                                <li>
                                  {{#is object_type 'comment'}}
                                    <a class="element-link font-size-sm" href={{url}}>{{t 'view_comment'}}</a>
                                  {{else}}
                                    <p class="element-paragraph inline my-0 font-size-sm text-subtle">
                                      {{author.name}}
                                    </p>
                                  {{/is}}
                                </li>
                                <li>
                                  <p class="element-paragraph inline my-0 font-size-sm text-subtle">
                                    {{#if editor}}
                                      {{#is object_type 'article'}}
                                        {{t 'updated'}}
                                      {{else}}
                                        {{t 'edited'}}
                                      {{/is}}
                                      {{date edited_at timeago=true}}
                                    {{else}}
                                      {{date created_at timeago=true}}
                                    {{/if}}
                                  </p>
                                </li>
                                {{#each stats}}
                                  <li>
                                    <p class="element-paragraph inline my-0 font-size-sm text-subtle">
                                      {{label}}
                                    </p>
                                  </li>
                                {{/each}}
                                {{#isnt status 'none'}}
                                  <li>
                                    <span class="element-badge badge badge-{{status_dasherized}}">{{status_name}}</span>
                                  </li>
                                {{/isnt}}
                                {{#if pending}}
                                  <li>
                                    <span class="element-badge badge badge-pending inline">{{t 'pending_approval'}}</span>
                                  </li>
                                {{/if}}
                                {{#if official}}
                                  <li>
                                    <span class="element-badge badge badge-official inline">{{t 'official_comment'}}</span>
                                  </li>
                                {{/if}}
                              </ul>

                            {{/with}}

                          </div> {{! / .element-card }}

                        </div> {{! / .element-group }}

                      </li>
                    {{/each}}
                  </ul>

                {{/if}}

                {{! Paragraph }}
                {{#unless activities}}
                  <p class="element-paragraph my-5 text-subtle font-size-md">
                    {{t 'no_contributions'}}
                  </p>
                {{/unless}}

              </div>
            {{/is}}
          {{/if}}
        {{/if}} {{! / .element-activity-list }}

        {{! Badge list }}
        {{#if visible}}
          {{#if member_since}}
            {{#is current_filter.identifier 'badges'}}
              <div class="element-badge-list badge-list mb-7" data-editable>
                {{#if user.badges}}

                  {{! Heading }}
                  <h2 class="element-heading mt-6 mb-1">
                    {{t 'badges'}}
                  </h2> {{! / .element-heading }}

                  {{! Paragraph }}
                  <p class="element-paragraph font-size-md text-subtle">
                    {{t 'badges_description' name=user.name}}
                  </p> {{! / .element-paragraph }}

                  {{! Badges }}
                  <ul class="list-unstyled">
                    {{#each user.badges}}
                      <li class="badge-item flex flex-wrap align-items-center py-2 border-top" aria-labelledby="title-{{id}}" aria-describedby="description-{{id}}">

                        {{#if icon_url}}
                          <img class="h-7 w-7 mr-4" src="{{icon_url}}" alt="{{name}}">
                        {{/if}}

                        <div class="flex-1">
                          <h3 class="element-heading mt-4 mb-1 font-size-base" id="title-{{id}}">
                            {{name}}
                          </h3>
                          <p class="element-paragraph text-subtle font-size-md" id="description-{{id}}">
                            {{description}}
                          </p>
                        </div>

                        <div class="text-right">
                          <h4 class="element-heading mt-4 mb-1 font-size-md">
                            {{t 'badges_awarded'}}
                          </h4>
                          <p class="element-paragraph text-subtle font-size-sm">
                            {{date assigned_at format='medium'}}
                          </p>
                        </div>

                      </li>
                    {{/each}}
                  </ul>

                {{/if}}

                {{! Paragraph }}
                {{#unless user.badges}}
                  <p class="element-paragraph my-5 text-subtle font-size-md">
                    {{t 'no_badges'}}
                  </p>
                {{/unless}}

              </div>
            {{/is}}
          {{/if}}
        {{/if}} {{! / .element-badge-list }}

        {{! Contribution list }}
        {{#if visible}}
          {{#if member_since}}
            {{#isnt current_filter.identifier 'activities'}}
              {{#isnt current_filter.identifier 'badges'}}
                <div class="element-contribution-list contribution-list mb-7" data-editable>

                  {{! Contributions }}
                  {{#if contributions}}

                    {{! Group }}
                    <div class="element-group md:flex align-items-end justify-content-between">

                      {{! Group }}
                      <div class="element-group flex-1">

                        {{! Heading element }}
                        <h2 class="element-heading mt-6 mb-1">
                          {{t current_filter.identifier}}
                        </h2> {{! / .element-heading }}

                        {{! Paragraph element }}
                        <p class="element-paragraph font-size-md text-subtle">
                          {{sorter_description}}
                        </p> {{! / .element-paragraph }}

                      </div>

                      {{! Sorters }}
                      <div class="dropdown mb-4 ml-auto font-size-md text-subtle" x-data="dropdown" x-bind="wrapper">
                        <button class="not-a-button text-inherit cursor-pointer" aria-haspopup="true" x-bind="trigger">
                          {{current_sorter.label}}
                          <svg class="svg-icon" aria-hidden="true" :class="{ 'rotate-180': isExpanded }">
                            <use xlink:href="#icon-chevron-down" />
                          </svg>
                        </button>
                        <div class="dropdown-menu" role="menu" x-bind="menu">
                          {{#each sorters}}
                            <a class="dropdown-item" href="{{url}}" aria-selected="{{selected}}" role="menuitem">
                              {{name}}
                            </a>
                          {{/each}}
                        </div>
                      </div>

                    </div> {{! / .element-group }}

                    {{! Contributions }}
                    {{#each contributions}}
                      <div class="contribution-item py-5 border-top">

                        {{#isnt object_type 'comment'}}
                          <h3 class="element-heading mt-0 mb-2 font-size-base">
                            <a class="element-link text-inherit" href="{{url}}">
                              {{title}}
                            </a>
                          </h3>
                        {{/isnt}}

                        <nav
                          {{#is object_type 'article'}}aria-label='{{t 'article_location_with_title' title=title}}'{{/is}}
                          {{#is object_type 'post'}}aria-label='{{t 'post_location_with_title' title=title}}'{{/is}}
                          {{#is object_type 'comment'}}aria-label='{{t 'comment_location_with_author_name' author_name=author.name}}'{{/is}}
                        >
                          <ol class="element-breadcrumbs breadcrumbs mb-2">
                            {{#each path_steps}}
                              <li title="{{name}}">
                                <a href="{{url}}">{{name}}</a>
                              </li>
                            {{/each}}
                          </ol>
                        </nav>

                        {{! Contribution body }}
                        <p class="element-paragraph font-size-md">
                          {{excerpt body characters=200}}
                        </p>

                        {{! Contribution metadata }}
                        <ul class="list-divider mb-0 font-size-sm text-subtle">
                          {{#is object_type 'comment'}}
                            <li>
                              <a class="element-link font-size-sm" href={{url}}>
                                {{t 'view_comment'}}
                              </a>
                            </li>
                          {{/is}}
                          <li>
                            <p class="element-paragraph inline my-0 font-size-sm text-subtle">
                              {{#if editor}}
                                {{#is object_type 'article'}}
                                  {{t 'updated'}}
                                {{else}}
                                  {{t 'edited'}}
                                {{/is}}
                                {{date edited_at timeago=true}}
                              {{else}}
                                {{date created_at timeago=true}}
                              {{/if}}
                            </p>
                          </li>
                          {{#each stats}}
                            <li>
                              <p class="element-paragraph inline my-0 font-size-sm text-subtle">
                                {{label}}
                              </p>
                            </li>
                          {{/each}}
                          {{#isnt status 'none'}}
                            <li>
                              <span class="element-badge badge badge-{{status_dasherized}}">
                                {{status_name}}
                              </span>
                            </li>
                          {{/isnt}}
                          {{#if pending}}
                            <li>
                              <span class="element-badge badge badge-pending">
                                {{t 'pending_approval'}}
                              </span>
                            </li>
                          {{/if}}
                          {{#if official}}
                            <li>
                              <span class="element-badge badge badge-official">
                                {{t 'official_comment'}}
                              </span>
                            </li>
                          {{/if}}
                        </ul>

                      </div>
                    {{/each}}

                  {{/if}}

                  {{! Paragraph }}
                  {{#unless contributions}}
                    <p class="element-paragraph my-5 text-subtle font-size-md">
                      {{t 'no_contributions'}}
                    </p>
                  {{/unless}}

                  {{! Pagination }}
                  {{#if pagination}}
                    <div class="element-pagination pagination my-6 js-pagination">
                      {{pagination}}
                    </div>
                  {{/if}}

                </div>
              {{/isnt}}
            {{/isnt}}
          {{/if}}
        {{/if}} {{! / .element-contribution-list }}

        {{! Paragraph }}
        {{#if visible}}
          {{#unless member_since}}
            <p class="element-paragraph my-5 text-subtle font-size-md" data-editable>
              {{t 'no_content_yet'}}
            </p>
          {{/unless}} {{! / .element-paragraph }}
        {{/if}}

        {{! Paragraph }}
        {{#unless visible}}
          <p class="element-paragraph my-5 text-subtle font-size-md" data-editable>
            <svg class="svg-icon text-base mr-1" aria-hidden="true">
              <use xlink:href="#icon-internal" />
            </svg>
            {{t 'private_activity'}}
          </p>
        {{/unless}} {{! / .element-paragraph }}

      </div> {{! / .element-column }}

    </div> {{! / .element-row }}

  </div> {{! / .element-container }}

</div> {{! /#page-container }}

<script type="text/javascript">
  document.documentElement.classList.add('user-profile-page', 'user-{{user.id}}');
</script>

